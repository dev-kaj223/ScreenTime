<Window x:Class="TimeGuard.UI.RuleEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit App Rule" Width="650" Height="780" MinWidth="620" MinHeight="520"
        Icon="{DynamicResource ScreenTimeBrandImage}" WindowStartupLocation="CenterOwner"
        Background="{StaticResource DarkBrush}">
    <Window.Resources>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#424254"/></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False" Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                                <Border Background="{TemplateBinding Background}" BorderBrush="#56566A" BorderThickness="1" CornerRadius="3" Padding="7,4">
                                    <ContentPresenter/>
                                </Border>
                            </ControlTemplate></ToggleButton.Template>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="⌄" Margin="8,0,0,0"/>
                            </Grid>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="#56566A" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer MaxHeight="240" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <TextBlock x:Name="ErrorText" AutomationProperties.AutomationId="RuleErrorText" Foreground="#F1B68B" FontSize="12"
                       Margin="0,0,0,10" Visibility="Collapsed" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save" AutomationProperties.AutomationId="SaveRuleButton" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Click="OnSave"/>
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Click="OnCancel" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="App display name" Foreground="{StaticResource SubtextBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="DisplayNameBox" AutomationProperties.AutomationId="DisplayNameBox" Margin="0,0,0,10"/>
                <TextBlock Text="Process name (without .exe)" Foreground="{StaticResource SubtextBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="ProcessNameBox" AutomationProperties.AutomationId="ProcessNameBox" Margin="0,0,0,18"/>
                <TextBlock Text="Daily limits" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="15"/>
                <TextBlock Text="0 hr 0 min is Unlimited. Downtime applies separately." Foreground="{StaticResource SubtextBrush}" Margin="0,4,0,10"/>
                <ItemsControl x:Name="DailyLimits">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextBrush}" Width="112" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Hours, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="{Binding HoursId}" AutomationProperties.Name="{Binding HoursId}" Width="95"/>
                            <TextBlock Text="hr" Foreground="{StaticResource SubtextBrush}" Margin="6,0,12,0" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Minutes, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="{Binding MinutesId}" AutomationProperties.Name="{Binding MinutesId}" Width="54"/>
                            <TextBlock Text="min" Foreground="{StaticResource SubtextBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Downtime" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="15" Margin="0,18,0,4"/>
                <TextBlock Text="Choose the days when downtime starts." Foreground="{StaticResource SubtextBrush}"/>
                <WrapPanel x:Name="PeriodDaysPanel" Margin="0,10,0,12"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Start" Foreground="{StaticResource SubtextBrush}" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="PeriodStartHourBox" AutomationProperties.AutomationId="PeriodStartHourBox" AutomationProperties.Name="Start hour" Width="62"/>
                            <ComboBox x:Name="PeriodStartMinuteBox" AutomationProperties.AutomationId="PeriodStartMinuteBox" AutomationProperties.Name="Start minute" Width="62"/>
                            <ComboBox x:Name="PeriodStartMeridiemBox" AutomationProperties.AutomationId="PeriodStartMeridiemBox" AutomationProperties.Name="Start AM or PM" Width="66"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="End" Foreground="{StaticResource SubtextBrush}" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="PeriodEndHourBox" AutomationProperties.AutomationId="PeriodEndHourBox" AutomationProperties.Name="End hour" Width="62"/>
                            <ComboBox x:Name="PeriodEndMinuteBox" AutomationProperties.AutomationId="PeriodEndMinuteBox" AutomationProperties.Name="End minute" Width="62"/>
                            <ComboBox x:Name="PeriodEndMeridiemBox" AutomationProperties.AutomationId="PeriodEndMeridiemBox" AutomationProperties.Name="End AM or PM" Width="66"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <CheckBox x:Name="PeriodNextDayBox" AutomationProperties.AutomationId="PeriodNextDayBox" Content="Next day" Margin="0,0,24,0"/>
                    <CheckBox x:Name="PeriodEnabledBox" AutomationProperties.AutomationId="PeriodEnabledBox" Content="Enabled" IsChecked="True"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button x:Name="AddPeriodButton" AutomationProperties.AutomationId="AddPeriodButton" Content="Add downtime" Style="{StaticResource SecondaryButton}" Click="OnAddPeriod" Margin="0,0,8,0"/>
                    <Button x:Name="CancelPeriodEditButton" AutomationProperties.AutomationId="CancelPeriodEditButton" Content="Cancel edit" Visibility="Collapsed" Style="{StaticResource SecondaryButton}" Click="OnCancelPeriodEdit"/>
                </StackPanel>
                <TextBlock x:Name="EmptyPeriodsText" Text="No downtime configured." Foreground="{StaticResource SubtextBrush}" Margin="0,0,0,6"/>
                <ListBox x:Name="PeriodsList" AutomationProperties.AutomationId="PeriodsList" MaxHeight="180" MinHeight="36" Background="{StaticResource SurfaceBrush}"
                         Foreground="{StaticResource TextBrush}" BorderBrush="#414155" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate><DataTemplate>
                        <StackPanel Margin="6,4"><TextBlock Text="{Binding Days}" FontWeight="SemiBold"/><TextBlock Text="{Binding Times}" Foreground="{StaticResource SubtextBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Edit selected" AutomationProperties.AutomationId="EditPeriodButton" Style="{StaticResource SecondaryButton}" Click="OnEditPeriod" Margin="0,0,8,0"/>
                    <Button Content="Remove selected" AutomationProperties.AutomationId="RemovePeriodButton" Style="{StaticResource SecondaryButton}" Click="OnRemovePeriod"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
