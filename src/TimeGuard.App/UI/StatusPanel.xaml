<Window x:Class="TimeGuard.UI.StatusPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenTime" Width="420" MaxHeight="650" SizeToContent="Height"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="True"
        Background="#1C1E24" Foreground="#F0F0F0" WindowStyle="None"
        Icon="{DynamicResource ScreenTimeBrandImage}">
    <DockPanel Margin="16" LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Image Source="{DynamicResource ScreenTimeBrandImage}" Width="24" Height="24"/>
                <TextBlock Text="ScreenTime" FontSize="18" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="#BAC1CD" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel>
        <UniformGrid DockPanel.Dock="Bottom" Columns="3" Margin="0,6,0,0">
            <Button x:Name="DashboardButton" Content="Dashboard" Style="{DynamicResource SecondaryButton}" Padding="10,8" Margin="0,0,6,0" Click="OnDashboard"/>
            <Button x:Name="SettingsButton" Content="Settings" Style="{DynamicResource SecondaryButton}" Padding="10,8" Margin="0,0,6,0" Click="OnSettings"/>
            <Button x:Name="ExitButton" Content="Exit" Style="{DynamicResource SecondaryButton}" Padding="10,8" Click="OnExit"/>
        </UniformGrid>
        <ScrollViewer x:Name="AppListScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="520">
            <ItemsControl x:Name="AppList" ItemsSource="{Binding Apps}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12" Margin="0,0,0,8" Background="#252831" BorderBrush="#414650" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayName}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding State}" Foreground="{Binding Accent}" FontWeight="Bold" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding Primary}" FontSize="20" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Secondary}" Foreground="#D7DEE9" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Upcoming}" Foreground="#BAC1CD" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
