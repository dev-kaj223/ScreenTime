<Window x:Class="TimeGuard.UI.StatusPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenTime" Width="420" MaxHeight="650" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Background="#1C1E24" Foreground="#F0F0F0" WindowStyle="ToolWindow"
        Icon="{DynamicResource ScreenTimeBrandImage}">
    <DockPanel Margin="16" LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Image Source="{DynamicResource ScreenTimeBrandImage}" Width="24" Height="24"/>
                <TextBlock Text="ScreenTime" FontSize="18" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="#BAC1CD" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel>
        <ScrollViewer x:Name="AppListScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="520">
            <ItemsControl x:Name="AppList" ItemsSource="{Binding Apps}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12" Margin="0,0,0,8" Background="#252831" BorderBrush="#414650" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayName}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding State}" Foreground="{Binding Accent}" FontWeight="Bold" Margin="0,6,0,0"/>
                                <StackPanel>
                                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasGrace}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                    <TextBlock Text="{Binding GraceCountdown}" FontSize="26" Foreground="#F4AD72"/>
                                    <TextBlock Text="{Binding GraceDetail}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Usage}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Remaining}" TextWrapping="Wrap"/>
                                <Expander Header="Details" Foreground="#BAC1CD" Margin="0,6,0,0"><StackPanel>
                                <TextBlock Text="{Binding Running}"/>
                                <TextBlock Text="{Binding Downtime}"/>
                                <TextBlock Text="{Binding Quota}"/>
                                <TextBlock Text="{Binding NextDowntime}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding NextAvailability}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Observed}" Foreground="#BAC1CD" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel></Expander>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
