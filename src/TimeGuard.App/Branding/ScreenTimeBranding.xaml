<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Shared replaceable interim clock mark. Phase 8 replaces this resource with the
         approved hourglass; consumers keep the ScreenTimeBrandImage contract. -->
    <DrawingImage x:Key="ScreenTimeBrandImage">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#D7DEE9" Geometry="M 16,0 A 16,16 0 1 1 15.99,0 M 16,3 A 13,13 0 1 0 16.01,3"/>
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#D7DEE9" Thickness="2.5" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry><PathGeometry Figures="M 16,7 L 16,16 L 23,20"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
